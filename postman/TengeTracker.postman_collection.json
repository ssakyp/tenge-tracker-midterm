{
  "info": {
    "_postman_id": "2e7b2e51-2bc8-4a65-9b0d-17d1a1e8bb77",
    "name": "Tenge Tracker API",
    "description": "Requests aligned with endpoints implemented in this repository. Run in order; IDs are captured automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Accounts and Transactions",
      "item": [
        {
          "name": "Create account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts"
              ]
            },
            "description": "Creates an account and saves its generated ID.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman demo wallet\",\n  \"balance\": 10000.0,\n  \"currency\": \"KZT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json(); if (data.id !== undefined) pm.collectionVariables.set('accountId', String(data.id)); pm.test('Created (201)', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "List accounts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts"
              ]
            },
            "description": "Lists all accounts."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OK (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get account by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{accountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{accountId}}"
              ]
            },
            "description": "Uses accountId saved by Create account."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OK (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
