              ]
            },
            "description": "Creates an income transaction and increases the account balance.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"amount\": 500.0,\n  \"type\": \"INCOME\",\n  \"date\": \"2026-10-21\",\n  \"description\": \"Postman demo income\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json(); if (data.id !== undefined) pm.collectionVariables.set('transactionId', String(data.id)); pm.test('Created (201)', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
